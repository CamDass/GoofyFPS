<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Serveur d'annuaire + rendez-vous NAT. Aucune dépendance au jeu :
         il partage juste la même bibliothèque réseau (LiteNetLib) pour le hole punching. -->
    <AssemblyName>GoofyMaster</AssemblyName>
    <RootNamespace>GoofyMaster</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiteNetLib" Version="2.1.3" />
  </ItemGroup>

</Project>
